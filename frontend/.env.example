# Copy to .env.local and fill in.

# Origin of the backend API — scheme and host only, no /api/v1 and no trailing
# slash; each call appends its own path. Must match the port the backend's PORT
# is set to.
#
# The session is httpOnly cookies set by this origin, so in production it has to
# be a real domain the browser will accept cookies from — not a bare IP, and on
# a different site than the frontend it needs the backend's CORS and cookie
# settings to agree.
NEXT_PUBLIC_API_URL=http://localhost:5000
