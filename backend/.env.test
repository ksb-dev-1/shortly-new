# Used only by the test suite. No real credentials belong in here — the tests
# never reach Resend or Cloudinary, so these exist purely to satisfy the checks
# in config/env.ts that run when the app is imported.

# The Docker container from docker-compose.test.yml. Note the port: 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shortly_test

NODE_ENV=test

ACCESS_TOKEN_SECRET=test-secret-not-used-anywhere-real

RESEND_API_KEY=re_test_fake
EMAIL_FROM=Shortly <test@example.com>
FRONTEND_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

STRIPE_SECRET_KEY=sk_test_fake
STRIPE_PRICE_ID_MONTHLY=price_test_monthly
STRIPE_PRICE_ID_YEARLY=price_test_yearly
STRIPE_WEBHOOK_SECRET=whsec_test_fake
