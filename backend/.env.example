# Copy to .env and fill in. Every value below is required unless marked
# optional — the server throws on startup naming the first one it can't find.

# --- Server ---------------------------------------------------------------

# Optional. Defaults to 5000.
PORT=5000

# Optional. Defaults to "development". Set to "production" in deployment —
# it is what puts the Secure flag on session cookies.
NODE_ENV=development

# Optional. Number of reverse proxies in front of the app; 0 means direct
# connections. Rate limiting keys on req.ip, which is only correct when this
# is accurate. Behind one proxy (Railway, Render, Fly, a single nginx) set 1.
TRUST_PROXY=0

# --- Database -------------------------------------------------------------

# Postgres connection string. Neon works out of the box; any Postgres will do.
# Run `npm run migrate` once against a fresh database to create the tables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth -----------------------------------------------------------------

# Signs the 15-minute access-token JWT. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Refresh tokens are NOT signed — they are opaque random values stored in the
# database — so there is no second secret to set.
ACCESS_TOKEN_SECRET=

# --- Email (Resend) -------------------------------------------------------

# From https://resend.com/api-keys. Used for verification and password-reset
# mail; without it signup succeeds but no one can confirm an address.
RESEND_API_KEY=

# Must be on a domain verified in Resend. Resend's onboarding sender
# (onboarding@resend.dev) works for local development and only delivers to
# the address that owns the Resend account.
EMAIL_FROM=Shortly <onboarding@resend.dev>

# Origin of the frontend. Used to build the links inside those emails, and as
# the allowed CORS origin. No trailing slash.
FRONTEND_URL=http://localhost:3000

# --- Avatar uploads (Cloudinary) ------------------------------------------

# From the Cloudinary dashboard. Avatars land in shortly/avatars/<user-id>/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
